generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoSource {
  UPLOAD
  YOUTUBE
}

model User {
  id                    String      @id @default(cuid())
  username              String      @unique
  isAdmin               Boolean     @default(false)
  passwordHash          String
  visitorPasswordHash   String?
  publicProfileEnabled  Boolean     @default(false)
  createdAt             DateTime    @default(now())
  recordings            Recording[]
}

model Recording {
  id          String      @id @default(cuid())
  title       String
  composer    String
  recordedAt  DateTime
  videoSource VideoSource
  videoUrl    String
  youtubeId   String?
  durationSec Int?
  tags        String[]    @default([])
  difficulty  Int
  tempoBpm    Int?
  notes       String?
  isFavorite  Boolean     @default(false)
  aiRating    Int?
  aiFeedback  String?
  aiFeedbackAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([title, composer])
  @@index([recordedAt])
  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  username  String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([username, createdAt])
}
