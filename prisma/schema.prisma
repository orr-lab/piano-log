generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoSource {
  UPLOAD
  YOUTUBE
}

model Recording {
  id          String      @id @default(cuid())
  title       String
  composer    String
  recordedAt  DateTime
  videoSource VideoSource
  videoUrl    String
  youtubeId   String?
  durationSec Int?
  tags        String[]    @default([])
  difficulty  Int
  tempoBpm    Int?
  notes       String?
  isFavorite  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([title, composer])
  @@index([recordedAt])
}
